<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WebPaper.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="About WebPaper">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with app logo and name -->
        <Grid Grid.Row="0" Padding="32,40">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF1E3A8A" Offset="0"/>
                    <GradientStop Color="#FF3B82F6" Offset="0.5"/>
                    <GradientStop Color="#FF60A5FA" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" Spacing="16">
                <!-- Logo -->
                <Border Background="White"
                       CornerRadius="16"
                       Width="100"
                       Height="100"
                       Padding="16"
                       HorizontalAlignment="Center">
                    <Image Source="Assets/WebPaperLogo.png"
                          Stretch="Uniform"/>
                </Border>
                <TextBlock Text="WebPaper"
                          FontSize="36"
                          FontWeight="Bold"
                          HorizontalAlignment="Center"
                          Foreground="White"/>
                <TextBlock x:Name="VersionText"
                          Text="Version 1.0.0-beta"
                          FontSize="14"
                          HorizontalAlignment="Center"
                          Foreground="#E0FFFFFF"/>
                <TextBlock Text="Interactive Webpage Wallpaper"
                          FontSize="15"
                          HorizontalAlignment="Center"
                          Foreground="#B0FFFFFF"
                          FontStyle="Italic"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="24,20">
            <StackPanel Spacing="20">

                <!-- Description -->
                <StackPanel Spacing="8">
                    <TextBlock Text="About"
                              FontSize="18"
                              FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="WebPaper transforms any webpage into a fully interactive desktop wallpaper for Windows. "/>
                        <Run Text="Browse the web, watch videos, check social media, or display live dashboards - all from your desktop wallpaper!"/>
                    </TextBlock>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Features -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Features"
                              FontSize="18"
                              FontWeight="SemiBold"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="✅ Fully interactive webpages" FontSize="14"/>
                        <TextBlock Text="✅ Desktop icons remain clickable" FontSize="14"/>
                        <TextBlock Text="✅ Secure cookie persistence" FontSize="14"/>
                        <TextBlock Text="✅ Auto-pause during fullscreen apps" FontSize="14"/>
                        <TextBlock Text="✅ Battery optimization" FontSize="14"/>
                        <TextBlock Text="✅ Windows 11 24H2 compatible" FontSize="14"/>
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Built with -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Built With"
                              FontSize="18"
                              FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14">
                        <Run Text="• "/>
                        <Run Text=".NET 8 &amp; C# 12" FontWeight="SemiBold"/>
                        <LineBreak/>
                        <Run Text="• "/>
                        <Run Text="WinUI 3" FontWeight="SemiBold"/>
                        <Run Text=" - Modern Windows UI framework"/>
                        <LineBreak/>
                        <Run Text="• "/>
                        <Run Text="WebView2" FontWeight="SemiBold"/>
                        <Run Text=" - Chromium-based web rendering"/>
                        <LineBreak/>
                        <Run Text="• "/>
                        <Run Text="Windows DPAPI" FontWeight="SemiBold"/>
                        <Run Text=" - AES-256 encryption for cookies"/>
                    </TextBlock>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Credits -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Credits"
                              FontSize="18"
                              FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14">
                        <Run Text="Inspired by "/>
                        <Hyperlink NavigateUri="https://github.com/rocksdanister/lively">
                            <Run Text="Lively Wallpaper"/>
                        </Hyperlink>
                        <Run Text=" by rocksdanister"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="Thanks to the Windows desktop development community and all contributors."/>
                    </TextBlock>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Links -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Links"
                              FontSize="18"
                              FontWeight="SemiBold"/>
                    <StackPanel Spacing="8">
                        <HyperlinkButton Content="📚 User Guide"
                                        Click="UserGuideButton_Click"
                                        Padding="0"/>
                        <HyperlinkButton Content="🐛 Report a Bug"
                                        Click="ReportBugButton_Click"
                                        Padding="0"/>
                        <HyperlinkButton Content="💡 Suggest a Feature"
                                        Click="FeatureRequestButton_Click"
                                        Padding="0"/>
                        <HyperlinkButton Content="🌐 GitHub Repository"
                                        Click="GitHubButton_Click"
                                        Padding="0"/>
                        <HyperlinkButton Content="💼 LinkedIn Profile"
                                        Click="LinkedInButton_Click"
                                        Padding="0"/>
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Created By -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Created By"
                              FontSize="18"
                              FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14">
                        <Run Text="Omprakash J (MrDuck)" FontWeight="SemiBold"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="💼 "/>
                        <Hyperlink NavigateUri="https://www.linkedin.com/in/omprakash-jat/">
                            <Run Text="LinkedIn Profile"/>
                        </Hyperlink>
                        <LineBreak/>
                        <Run Text="🐙 "/>
                        <Hyperlink NavigateUri="https://github.com/Mr-Ducky-Pilot">
                            <Run Text="GitHub Profile"/>
                        </Hyperlink>
                        <LineBreak/><LineBreak/>
                        <Run Text="For collaboration or commercial licensing:"/>
                        <LineBreak/>
                        <Run Text="📧 omprakashj2010@gmail.com"/>
                    </TextBlock>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- License -->
                <StackPanel Spacing="8">
                    <TextBlock Text="License"
                              FontSize="18"
                              FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14">
                        <Run Text="Personal &amp; Hobbyist Use License"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="Copyright © 2025 Omprakash J (MrDuck)"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="✅ Free for personal and hobbyist use"/>
                        <LineBreak/>
                        <Run Text="❌ Not for commercial use without licensing"/>
                        <LineBreak/>
                        <Run Text="📝 Attribution required"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="See LICENSE file for full details."/>
                    </TextBlock>
                </StackPanel>

                <!-- System info -->
                <StackPanel Spacing="4" Margin="0,16,0,0">
                    <TextBlock Text="System Information"
                              FontSize="12"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="SystemInfoText"
                              FontSize="11"
                              FontFamily="Consolas"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              Padding="24,16"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Button Content="Close"
                   Click="CloseButton_Click"
                   HorizontalAlignment="Right"
                   MinWidth="100"/>
        </Grid>
    </Grid>
</Window>

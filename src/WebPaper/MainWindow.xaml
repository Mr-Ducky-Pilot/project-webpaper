<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WebPaper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WebPaper">

    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- WebView2 will render the webpage here -->
        <WebView2 x:Name="webView"
                  Source="https://www.example.com"
                  DefaultBackgroundColor="Transparent">
            <WebView2.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="⚙️ Settings" Click="SettingsMenuItem_Click"/>
                    <MenuFlyoutItem Text="🔄 Reload Wallpaper" Click="ReloadMenuItem_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="ℹ️ About WebPaper" Click="AboutMenuItem_Click"/>
                </MenuFlyout>
            </WebView2.ContextFlyout>
        </WebView2>

        <!-- Loading indicator (shown during initialization) -->
        <StackPanel x:Name="LoadingPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Visible">
            <ProgressRing IsActive="True"
                         Width="50"
                         Height="50"
                         Foreground="White"/>
            <TextBlock Text="Initializing WebPaper..."
                      Margin="0,10,0,0"
                      Foreground="White"
                      FontSize="16"/>
        </StackPanel>

        <!-- Error panel (shown if initialization fails) -->
        <StackPanel x:Name="ErrorPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Background="#CC000000"
                    Padding="20"
                    CornerRadius="8">
            <TextBlock Text="⚠️ Error"
                      Foreground="Red"
                      FontSize="24"
                      FontWeight="Bold"
                      HorizontalAlignment="Center"/>
            <TextBlock x:Name="ErrorMessage"
                      Text="Failed to initialize WebPaper"
                      Foreground="White"
                      FontSize="14"
                      Margin="0,10,0,0"
                      TextWrapping="Wrap"
                      MaxWidth="400"
                      HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>

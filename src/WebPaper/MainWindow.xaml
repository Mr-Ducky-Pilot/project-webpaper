<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WebPaper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WebPaper"
    PreviewKeyDown="Window_PreviewKeyDown">

    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- WebView2 will render the webpage here -->
        <!-- IMPORTANT: No Source property - we initialize manually with custom environment -->
        <WebView2 x:Name="webView"
                  DefaultBackgroundColor="Transparent">
            <WebView2.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="⚙️ Settings" Click="SettingsMenuItem_Click"/>
                    <MenuFlyoutItem Text="🔄 Reload Wallpaper" Click="ReloadMenuItem_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="ℹ️ About WebPaper" Click="AboutMenuItem_Click"/>
                </MenuFlyout>
            </WebView2.ContextFlyout>
        </WebView2>

        <!-- Loading indicator (shown during initialization) -->
        <Grid x:Name="LoadingPanel"
              Visibility="Visible">
            <Grid.Background>
                <!-- Pleasant blue gradient background -->
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF1E3A8A" Offset="0"/>
                    <GradientStop Color="#FF3B82F6" Offset="0.5"/>
                    <GradientStop Color="#FF60A5FA" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       MaxWidth="400">
                <!-- Logo -->
                <Border Background="White"
                       CornerRadius="16"
                       Width="120"
                       Height="120"
                       Padding="20"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,32">
                    <Image Source="Assets/WebPaperLogo.png"
                          Stretch="Uniform"/>
                </Border>

                <!-- App Name -->
                <TextBlock Text="WebPaper"
                          FontSize="36"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,8"/>

                <TextBlock Text="Interactive Desktop Wallpaper"
                          FontSize="16"
                          Foreground="#E0FFFFFF"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,32"/>

                <!-- Progress Ring -->
                <ProgressRing IsActive="True"
                            Width="48"
                            Height="48"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16"/>

                <!-- Status Text -->
                <TextBlock x:Name="LoadingStatusText"
                          Text="Initializing..."
                          Foreground="White"
                          FontSize="14"
                          HorizontalAlignment="Center"
                          TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Error panel (shown if initialization fails) -->
        <Grid x:Name="ErrorPanel"
              Visibility="Collapsed">
            <Grid.Background>
                <!-- Dark red gradient for errors -->
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF7F1D1D" Offset="0"/>
                    <GradientStop Color="#FF991B1B" Offset="0.5"/>
                    <GradientStop Color="#FFB91C1C" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       MaxWidth="500">
                <Border Background="#DD000000"
                       CornerRadius="12"
                       Padding="32">

                    <StackPanel Spacing="16">
                        <!-- Error Icon and Title -->
                        <StackPanel Orientation="Horizontal"
                                   HorizontalAlignment="Center"
                                   Spacing="12">
                            <TextBlock Text="⚠️"
                                      FontSize="32"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="Initialization Error"
                                      Foreground="#FFFCA5A5"
                                      FontSize="24"
                                      FontWeight="Bold"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Error Message -->
                        <TextBlock x:Name="ErrorMessage"
                                  Text="Failed to initialize WebPaper"
                                  Foreground="White"
                                  FontSize="14"
                                  TextWrapping="Wrap"
                                  HorizontalAlignment="Center"
                                  TextAlignment="Center"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal"
                                   HorizontalAlignment="Center"
                                   Spacing="12"
                                   Margin="0,16,0,0">
                            <Button Content="Retry"
                                   Click="RetryButton_Click"
                                   MinWidth="100"/>
                            <Button Content="Exit"
                                   Click="ExitButton_Click"
                                   MinWidth="100"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

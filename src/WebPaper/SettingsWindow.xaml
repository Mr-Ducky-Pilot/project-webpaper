<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WebPaper.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WebPaper Settings">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              Padding="24,20">
            <StackPanel>
                <TextBlock Text="⚙️ Settings"
                          FontSize="28"
                          FontWeight="Bold"/>
                <TextBlock Text="Configure your interactive wallpaper"
                          FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" Padding="24,16">
            <StackPanel Spacing="24">

                <!-- Wallpaper URL Section -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Wallpaper URL"
                              FontSize="18"
                              FontWeight="SemiBold"/>

                    <TextBlock Text="Enter the URL of the webpage you want as your wallpaper"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap"/>

                    <TextBox x:Name="UrlTextBox"
                            PlaceholderText="https://www.example.com"
                            MinHeight="40"
                            FontSize="14"
                            TextChanged="UrlTextBox_TextChanged"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Open Login Helper"
                               Click="LoginButton_Click"
                               Style="{StaticResource AccentButtonStyle}">
                            <Button.Resources>
                                <x:String x:Key="Icon">&#xE1A7;</x:String>
                            </Button.Resources>
                        </Button>
                        <Button Content="Test URL"
                               Click="TestUrlButton_Click"/>
                    </StackPanel>

                    <!-- URL Suggestions -->
                    <TextBlock Text="Popular choices:"
                              FontSize="12"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              Margin="0,8,0,0"/>
                    <StackPanel Spacing="4">
                        <Button Content="YouTube" Click="SuggestionButton_Click" Tag="https://www.youtube.com" HorizontalAlignment="Left" Style="{StaticResource SubtleButtonStyle}" Padding="8,4"/>
                        <Button Content="Reddit" Click="SuggestionButton_Click" Tag="https://www.reddit.com" HorizontalAlignment="Left" Style="{StaticResource SubtleButtonStyle}" Padding="8,4"/>
                        <Button Content="Windy (Weather)" Click="SuggestionButton_Click" Tag="https://www.windy.com" HorizontalAlignment="Left" Style="{StaticResource SubtleButtonStyle}" Padding="8,4"/>
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Performance Section -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Performance"
                              FontSize="18"
                              FontWeight="SemiBold"/>

                    <ToggleSwitch x:Name="PerformanceToggle"
                                 Header="Enable Performance Optimization"
                                 OnContent="Enabled"
                                 OffContent="Disabled"
                                 Toggled="PerformanceToggle_Toggled">
                        <ToggleSwitch.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Enable Performance Optimization" FontWeight="SemiBold"/>
                                    <TextBlock Text="Automatically pause wallpaper during fullscreen apps and low battery"
                                              FontSize="12"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              TextWrapping="Wrap"
                                              Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ToggleSwitch.HeaderTemplate>
                    </ToggleSwitch>

                    <StackPanel Spacing="8" x:Name="PerformanceSettings">
                        <TextBlock Text="Battery Pause Threshold"
                                  FontSize="14"
                                  FontWeight="SemiBold"/>
                        <TextBlock Text="Pause wallpaper when battery drops below this percentage"
                                  FontSize="12"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Slider x:Name="BatterySlider"
                                   Grid.Column="0"
                                   Minimum="10"
                                   Maximum="50"
                                   Value="20"
                                   StepFrequency="5"
                                   TickFrequency="10"
                                   TickPlacement="BottomRight"
                                   ValueChanged="BatterySlider_ValueChanged"/>

                            <TextBlock Grid.Column="1"
                                      x:Name="BatteryValueText"
                                      Text="20%"
                                      FontSize="14"
                                      FontWeight="Bold"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      MinWidth="50"/>
                        </Grid>

                        <ToggleSwitch x:Name="NotificationsToggle"
                                     OnContent="Show"
                                     OffContent="Hide"
                                     Toggled="NotificationsToggle_Toggled">
                            <ToggleSwitch.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="Pause/Resume Notifications" FontWeight="SemiBold"/>
                                        <TextBlock Text="Show notifications when wallpaper is paused or resumed"
                                                  FontSize="12"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ToggleSwitch.HeaderTemplate>
                        </ToggleSwitch>
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Application Settings -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Application"
                              FontSize="18"
                              FontWeight="SemiBold"/>

                    <ToggleSwitch x:Name="AutoStartToggle"
                                 OnContent="Enabled"
                                 OffContent="Disabled"
                                 Toggled="AutoStartToggle_Toggled">
                        <ToggleSwitch.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" FontWeight="SemiBold"/>
                                    <TextBlock Text="Automatically launch WebPaper when you log in"
                                              FontSize="12"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ToggleSwitch.HeaderTemplate>
                    </ToggleSwitch>

                    <ToggleSwitch x:Name="TrayToggle"
                                 OnContent="Enabled"
                                 OffContent="Disabled"
                                 Toggled="TrayToggle_Toggled">
                        <ToggleSwitch.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Minimize to System Tray" FontWeight="SemiBold"/>
                                    <TextBlock Text="Minimize to tray instead of taskbar"
                                              FontSize="12"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ToggleSwitch.HeaderTemplate>
                    </ToggleSwitch>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Cookie Management -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Cookie Management"
                              FontSize="18"
                              FontWeight="SemiBold"/>

                    <TextBlock x:Name="CookieInfoText"
                              Text="No saved cookies"
                              FontSize="12"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <Button Content="Clear Saved Cookies"
                           Click="ClearCookiesButton_Click"
                           HorizontalAlignment="Left"/>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Advanced -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Advanced"
                              FontSize="18"
                              FontWeight="SemiBold"/>

                    <Button Content="Reset to Default Settings"
                           Click="ResetButton_Click"
                           HorizontalAlignment="Left"/>

                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                        <Run Text="Config file:"/>
                        <Run x:Name="ConfigPathText" Text=""/>
                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              Padding="24,16"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="StatusText"
                          Text="Ready"
                          FontSize="12"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <Button Content="Cancel"
                       Click="CancelButton_Click"
                       MinWidth="100"/>
                <Button Content="Save"
                       Click="SaveButton_Click"
                       Style="{StaticResource AccentButtonStyle}"
                       MinWidth="100"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

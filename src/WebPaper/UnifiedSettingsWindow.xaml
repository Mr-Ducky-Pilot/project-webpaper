<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WebPaper.UnifiedSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WebPaper Settings">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              Padding="24,20">
            <StackPanel>
                <TextBlock Text="WebPaper Settings"
                          FontSize="28"
                          FontWeight="Bold"/>
                <TextBlock x:Name="VersionText"
                          Text="Version 1.0.0"
                          FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" Padding="24,16">
            <StackPanel Spacing="24">

                <!-- Home URL Section -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Home URL"
                              FontSize="18"
                              FontWeight="SemiBold"/>

                    <TextBlock Text="The webpage to display as your wallpaper"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="HomeUrlTextBox"
                                Grid.Column="0"
                                PlaceholderText="https://example.com"
                                MinHeight="40"
                                FontSize="14"
                                Margin="0,0,8,0"/>
                        <Button x:Name="ApplyUrlButton"
                               Grid.Column="1"
                               Content="Apply and Reload"
                               Click="ApplyUrlButton_Click"
                               MinWidth="120"/>
                    </Grid>
                </StackPanel>

                <!-- Performance Settings -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Performance"
                              FontSize="18"
                              FontWeight="SemiBold"/>

                    <ToggleSwitch x:Name="PerformanceToggle"
                                 Header="Auto-Pause During Fullscreen"
                                 OnContent="Enabled"
                                 OffContent="Disabled"
                                 Toggled="PerformanceToggle_Toggled"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Battery Pause Threshold" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="BatterySlider"
                                   Grid.Column="0"
                                   Minimum="10"
                                   Maximum="50"
                                   StepFrequency="5"
                                   ValueChanged="BatterySlider_ValueChanged"/>
                            <TextBlock Grid.Column="1"
                                      x:Name="BatteryValueText"
                                      Text="20%"
                                      VerticalAlignment="Center"
                                      Margin="12,0,0,0"
                                      MinWidth="40"/>
                        </Grid>
                        <TextBlock Text="Wallpaper will auto-pause when battery drops below this level"
                                  FontSize="12"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- Monitor Information -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Display Information"
                              FontSize="18"
                              FontWeight="SemiBold"/>
                    <TextBlock x:Name="MonitorInfoText"
                              Text="Loading monitor information..."
                              TextWrapping="Wrap"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- About Section -->
                <StackPanel Spacing="12">
                    <TextBlock Text="About"
                              FontSize="18"
                              FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        WebPaper transforms any webpage into a fully interactive desktop wallpaper for Windows.
                    </TextBlock>

                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <HyperlinkButton Content="GitHub Repository"
                                        Click="GitHubButton_Click"
                                        Padding="0"/>
                        <HyperlinkButton Content="Report a Bug"
                                        Click="ReportBugButton_Click"
                                        Padding="0"/>
                        <HyperlinkButton Content="LinkedIn - Omprakash J"
                                        Click="LinkedInButton_Click"
                                        Padding="0"/>
                    </StackPanel>

                    <TextBlock Margin="0,12,0,0"
                              FontSize="12"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                        <Run Text="Made with love by MrDuck"/>
                        <LineBreak/>
                        <Run Text="Email: omprakashj2010@gmail.com"/>
                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer with Action Buttons -->
        <Grid Grid.Row="2"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ExitAppButton"
                   Content="Exit WebPaper"
                   Grid.Column="0"
                   Click="ExitAppButton_Click"
                   MinWidth="120"/>

            <Button x:Name="CloseButton"
                   Content="Close"
                   Grid.Column="2"
                   Click="CloseButton_Click"
                   MinWidth="100"/>
        </Grid>
    </Grid>
</Window>

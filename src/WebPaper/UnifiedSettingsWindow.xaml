<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WebPaper.UnifiedSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WebPaper Settings">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,20">
            <StackPanel Spacing="4">
                <TextBlock Text="WebPaper Settings" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Text="Version 1.0.0" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="24,20">
            <StackPanel Spacing="24" MaxWidth="700">

                <!-- Home URL Section -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Home URL" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="The webpage to display as your wallpaper" TextWrapping="Wrap"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="HomeUrlTextBox"
                                PlaceholderText="https://example.com"
                                Grid.Column="0"/>
                        <Button x:Name="ApplyUrlButton"
                               Content="Apply and Reload"
                               Grid.Column="1"
                               Click="ApplyUrlButton_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Control Mode Section -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Control Mode" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap">
                        Choose how you want to interact with your wallpaper and desktop
                    </TextBlock>

                    <StackPanel Spacing="8">
                        <RadioButton x:Name="WebPaperControlRadio"
                                    Content="WebPaper Control (Default)"
                                    IsChecked="True"
                                    Checked="ControlModeRadio_Checked"/>
                        <TextBlock Text="Interact with webpage - click, type, scroll. Desktop icons clickable."
                                  TextWrapping="Wrap"
                                  Margin="32,0,0,0"
                                  FontSize="12"/>

                        <RadioButton x:Name="DesktopControlRadio"
                                    Content="Desktop Control"
                                    Checked="ControlModeRadio_Checked"
                                    Margin="0,12,0,0"/>
                        <TextBlock Text="Static wallpaper - no webpage interaction. All inputs go to Windows/desktop."
                                  TextWrapping="Wrap"
                                  Margin="32,0,0,0"
                                  FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Performance Settings -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Performance" FontSize="18" FontWeight="SemiBold"/>

                    <ToggleSwitch x:Name="PerformanceToggle"
                                 Header="Auto-Pause During Fullscreen"
                                 OnContent="Enabled"
                                 OffContent="Disabled"
                                 Toggled="PerformanceToggle_Toggled"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Battery Pause Threshold" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="BatterySlider"
                                   Grid.Column="0"
                                   Minimum="10"
                                   Maximum="50"
                                   StepFrequency="5"
                                   TickFrequency="10"
                                   TickPlacement="BottomRight"
                                   ValueChanged="BatterySlider_ValueChanged"/>
                            <TextBlock Grid.Column="1"
                                      x:Name="BatteryValueText"
                                      Text="20%"
                                      VerticalAlignment="Center"
                                      Margin="12,0,0,0"
                                      MinWidth="40"/>
                        </Grid>
                        <TextBlock Text="Wallpaper will auto-pause when battery drops below this level"
                                  FontSize="12"
                                  TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- Monitor Information -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Display Information" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="MonitorInfoText"
                              Text="Loading monitor information..."
                              TextWrapping="Wrap"/>
                </StackPanel>

                <!-- About Section -->
                <StackPanel Spacing="12">
                    <TextBlock Text="About" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap">
                        WebPaper transforms any webpage into a fully interactive desktop wallpaper for Windows.
                    </TextBlock>

                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <HyperlinkButton Content="GitHub Repository"
                                        Click="GitHubButton_Click"
                                        Padding="0"/>
                        <HyperlinkButton Content="Report a Bug"
                                        Click="ReportBugButton_Click"
                                        Padding="0"/>
                        <HyperlinkButton Content="LinkedIn - Omprakash J"
                                        Click="LinkedInButton_Click"
                                        Padding="0"/>
                    </StackPanel>

                    <TextBlock Margin="0,12,0,0" FontSize="12">
                        <Run Text="Made with love by MrDuck"/>
                        <LineBreak/>
                        <Run Text="Email: omprakashj2010@gmail.com"/>
                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer with Action Buttons -->
        <Grid Grid.Row="2" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ExitAppButton"
                   Content="Exit WebPaper"
                   Grid.Column="0"
                   Click="ExitAppButton_Click"/>

            <Button x:Name="CloseButton"
                   Content="Close"
                   Grid.Column="2"
                   Click="CloseButton_Click"
                   MinWidth="100"/>
        </Grid>
    </Grid>
</Window>

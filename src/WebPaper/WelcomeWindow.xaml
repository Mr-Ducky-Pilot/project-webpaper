<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WebPaper.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Welcome to WebPaper">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer>
            <StackPanel MaxWidth="700" Padding="40" Spacing="24">

                <!-- Header -->
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="🌐"
                              FontSize="72"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Welcome to WebPaper"
                              FontSize="36"
                              FontWeight="Bold"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Transform any webpage into a fully interactive desktop wallpaper"
                              FontSize="16"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              HorizontalAlignment="Center"
                              TextWrapping="Wrap"
                              TextAlignment="Center"/>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Features -->
                <StackPanel Spacing="16">
                    <TextBlock Text="✨ Features"
                              FontSize="24"
                              FontWeight="SemiBold"/>

                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="🖱️" FontSize="24" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Fully Interactive" FontWeight="SemiBold"/>
                                <TextBlock Text="Click, scroll, type, and interact with any website"
                                          FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="🖥️" FontSize="24" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Desktop Icons On Top" FontWeight="SemiBold"/>
                                <TextBlock Text="Your icons remain visible and fully clickable"
                                          FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="🔐" FontSize="24" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Secure Cookie Storage" FontWeight="SemiBold"/>
                                <TextBlock Text="Stay logged in with encrypted authentication"
                                          FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="⚡" FontSize="24" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Smart Performance" FontWeight="SemiBold"/>
                                <TextBlock Text="Auto-pauses during games and low battery"
                                          FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- URL Input -->
                <StackPanel Spacing="12">
                    <TextBlock Text="🎯 Choose Your Wallpaper"
                              FontSize="24"
                              FontWeight="SemiBold"/>

                    <TextBlock Text="Enter the URL of any webpage you want as your wallpaper:"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap"/>

                    <TextBox x:Name="UrlTextBox"
                            PlaceholderText="https://www.example.com"
                            Text="https://www.example.com"
                            MinHeight="48"
                            FontSize="16"
                            TextChanged="UrlTextBox_TextChanged"/>

                    <TextBlock x:Name="UrlValidationText"
                              Foreground="Red"
                              FontSize="12"
                              Visibility="Collapsed"/>

                    <!-- Popular Suggestions -->
                    <TextBlock Text="Or try one of these popular choices:"
                              FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Margin="0,8,0,0"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="🎥 YouTube"
                               Click="SuggestionButton_Click"
                               Tag="https://www.youtube.com"/>
                        <Button Content="📰 Reddit"
                               Click="SuggestionButton_Click"
                               Tag="https://www.reddit.com"/>
                        <Button Content="🌦️ Windy"
                               Click="SuggestionButton_Click"
                               Tag="https://www.windy.com"/>
                        <Button Content="🎨 Unsplash"
                               Click="SuggestionButton_Click"
                               Tag="https://unsplash.com"/>
                    </StackPanel>
                </StackPanel>

                <!-- Info Box -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       Padding="16"
                       CornerRadius="8"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="💡 Tips for best experience:"
                                  FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap"
                                  FontSize="12"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="• Use light-colored websites for better icon visibility"/>
                            <LineBreak/>
                            <Run Text="• Websites with minimal animations save battery"/>
                            <LineBreak/>
                            <Run Text="• Right-click the desktop anytime to access settings"/>
                            <LineBreak/>
                            <Run Text="• Check system tray icon for quick controls"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal"
                           Spacing="12"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0">
                    <Button Content="Get Started"
                           Click="GetStartedButton_Click"
                           MinWidth="160"
                           Padding="24,12"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

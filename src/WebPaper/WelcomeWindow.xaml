<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WebPaper.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Welcome to WebPaper">

    <Grid>
        <Grid.Background>
            <!-- Pleasant blue gradient background -->
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1E3A8A" Offset="0"/>
                <GradientStop Color="#FF3B82F6" Offset="0.5"/>
                <GradientStop Color="#FF60A5FA" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer>
            <StackPanel MaxWidth="700" Padding="40,60,40,40" Spacing="32">

                <!-- Header with Logo -->
                <StackPanel Spacing="24" HorizontalAlignment="Center">
                    <!-- Logo -->
                    <Border Background="White"
                           CornerRadius="20"
                           Width="140"
                           Height="140"
                           Padding="24"
                           HorizontalAlignment="Center">
                        <Image Source="Assets/WebPaperLogo.png"
                              Stretch="Uniform"/>
                    </Border>

                    <TextBlock Text="Welcome to WebPaper"
                              FontSize="40"
                              FontWeight="Bold"
                              Foreground="White"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Transform any webpage into a fully interactive desktop wallpaper"
                              FontSize="18"
                              Foreground="#E0FFFFFF"
                              HorizontalAlignment="Center"
                              TextWrapping="Wrap"
                              TextAlignment="Center"
                              MaxWidth="500"/>
                </StackPanel>

                <!-- Main Content Card -->
                <Border Background="White"
                       CornerRadius="16"
                       Padding="32">

                    <StackPanel Spacing="24">

                        <!-- Features -->
                        <StackPanel Spacing="20">
                            <TextBlock Text="✨ What You Can Do"
                                      FontSize="22"
                                      FontWeight="Bold"
                                      Foreground="#FF1E3A8A"/>

                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Border Background="#FFF0F9FF"
                                           Width="48"
                                           Height="48"
                                           CornerRadius="24"
                                           Padding="8">
                                        <TextBlock Text="🖱️" FontSize="24"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Fully Interactive" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="Click, scroll, type, and interact with any website"
                                                  FontSize="13"
                                                  Foreground="#FF666666"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Border Background="#FFF0F9FF"
                                           Width="48"
                                           Height="48"
                                           CornerRadius="24"
                                           Padding="8">
                                        <TextBlock Text="🖥️" FontSize="24"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Desktop Icons On Top" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="Your icons remain visible and fully clickable"
                                                  FontSize="13"
                                                  Foreground="#FF666666"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Border Background="#FFF0F9FF"
                                           Width="48"
                                           Height="48"
                                           CornerRadius="24"
                                           Padding="8">
                                        <TextBlock Text="⚡" FontSize="24"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Smart Performance" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="Auto-pauses during games and low battery"
                                                  FontSize="13"
                                                  Foreground="#FF666666"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="#FFE5E7EB" Margin="0,8,0,8"/>

                        <!-- URL Input -->
                        <StackPanel Spacing="16">
                            <TextBlock Text="🎯 Choose Your Wallpaper"
                                      FontSize="22"
                                      FontWeight="Bold"
                                      Foreground="#FF1E3A8A"/>

                            <TextBlock Text="Enter the URL of any webpage:"
                                      Foreground="#FF666666"
                                      FontSize="14"
                                      TextWrapping="Wrap"/>

                            <TextBox x:Name="UrlTextBox"
                                    PlaceholderText="https://www.example.com"
                                    Text="https://www.example.com"
                                    MinHeight="52"
                                    FontSize="16"
                                    Foreground="#FF1F2937"
                                    Background="White"
                                    BorderBrush="#FFD1D5DB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    TextChanged="UrlTextBox_TextChanged">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF9CA3AF"/>
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF9CA3AF"/>
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF9CA3AF"/>
                                </TextBox.Resources>
                            </TextBox>

                            <TextBlock x:Name="UrlValidationText"
                                      Foreground="#FFDC2626"
                                      FontSize="12"
                                      Visibility="Collapsed"/>

                            <!-- Popular Suggestions -->
                            <TextBlock Text="Or try one of these:"
                                      FontSize="14"
                                      Foreground="#FF666666"
                                      Margin="0,8,0,0"/>

                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="🎥 YouTube"
                                           Click="SuggestionButton_Click"
                                           Tag="https://www.youtube.com"
                                           Foreground="#FF1F2937"
                                           Padding="16,10"/>
                                    <Button Content="📰 Reddit"
                                           Click="SuggestionButton_Click"
                                           Tag="https://www.reddit.com"
                                           Foreground="#FF1F2937"
                                           Padding="16,10"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="🌦️ Windy"
                                           Click="SuggestionButton_Click"
                                           Tag="https://www.windy.com"
                                           Foreground="#FF1F2937"
                                           Padding="16,10"/>
                                    <Button Content="🎨 Unsplash"
                                           Click="SuggestionButton_Click"
                                           Tag="https://unsplash.com"
                                           Foreground="#FF1F2937"
                                           Padding="16,10"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Info Box -->
                        <Border Background="#FFFEF3C7"
                               Padding="16"
                               CornerRadius="8"
                               BorderBrush="#FFFCD34D"
                               BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="💡 Tips for Best Experience"
                                          FontWeight="SemiBold"
                                          Foreground="#FF78350F"/>
                                <TextBlock TextWrapping="Wrap"
                                          FontSize="12"
                                          Foreground="#FF92400E">
                                    <Run Text="• Use light-colored websites for better icon visibility"/>
                                    <LineBreak/>
                                    <Run Text="• Websites with minimal animations save battery"/>
                                    <LineBreak/>
                                    <Run Text="• Right-click desktop anytime to access settings"/>
                                    <LineBreak/>
                                    <Run Text="• Check system tray icon for quick controls"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Action Button -->
                        <Button x:Name="GetStartedButton"
                               Content="Get Started →"
                               Click="GetStartedButton_Click"
                               HorizontalAlignment="Stretch"
                               Padding="0,16"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,8,0,0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF3B82F6" Offset="0"/>
                                    <GradientStop Color="#FF2563EB" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>

                        <Border Height="1" Background="#FFE5E7EB" Margin="0,16,0,8"/>

                        <!-- Footer - Created By & Repo Link -->
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center">
                                <Run Text="Created with ❤️ by "
                                     FontSize="13"
                                     Foreground="#FF666666"/>
                                <Run Text="Omprakash J (MrDuck)"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="#FF1E3A8A"/>
                            </TextBlock>

                            <HyperlinkButton Content="🐙 View on GitHub"
                                           NavigateUri="https://github.com/Mr-Ducky-Pilot/project-webpaper"
                                           HorizontalAlignment="Center"
                                           Padding="12,6"
                                           FontSize="12"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
